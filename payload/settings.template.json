{
  "lastChangelogVersion": "1.0.0",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "low",
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:pi-zentui",
    "npm:@narumitw/pi-usage",
    "npm:pi-hashline-edit-pro",
    "npm:pi-subagents",
    "npm:pi-jev-guardian",
    "npm:pi-jev-skill-suggester"
  ],
  "hideThinkingBlock": false,
  "externalEditor": "code --wait",
  "defaultTools": [
    "+grep",
    "+find",
    "+ls",
    "+codemode"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "contact_supervisor",
          "codemode"
        ]
      },
      "researcher": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "codemode"
        ],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-web-access/index.ts"
        ]
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "xhigh",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "codemode"
        ],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-web-access/index.ts"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high",
        "fast": false,
        "defaultContext": "fresh",
        "tools": "inherit",
        "extensions": [],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-lens/dist/index.js",
          "{{PROFILE}}/npm/node_modules/pi-hashline-edit-pro/index.ts"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "xhigh",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "watchdog_diff",
          "contact_supervisor",
          "codemode"
        ],
        "extensions": [],
        "excludeTools": [
          "bash",
          "powershell",
          "edit",
          "write",
          "replace",
          "insert",
          "undo_last_change"
        ],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-hashline-edit-pro/index.ts"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "codemode"
        ]
      },
      "delegate": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "codemode"
        ],
        "allowNestedSubagents": true
      }
    }
  },
  "tuiMode": "fullscreen"
}
