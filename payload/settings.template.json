{
  "theme": "system",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    {
      "source": "npm:pi-lens",
      "skills": [
        "-skills/pi-lens-write-ast-grep-rule/SKILL.md",
        "-skills/pi-lens-write-tree-sitter-rule/SKILL.md"
      ]
    },
    "npm:@narumitw/pi-usage",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "-skills/ponytail-help/SKILL.md",
        "-skills/ponytail-gain/SKILL.md"
      ]
    },
    "npm:pi-hashline-edit-pro",
    {
      "source": "npm:pi-subagents",
      "skills": [
        "-skills/council-mode/SKILL.md"
      ]
    },
    "npm:@narumitw/pi-btw",
    "npm:pi-jev-guardian",
    "npm:pi-hermes-memory",
    "npm:pi-background-tasks",
    "npm:@buyong/pi-claude-bridge",
    "npm:pi-cc-extensions"
  ],
  "hideThinkingBlock": false,
  "externalEditor": "code --wait",
  "defaultTools": [
    "+grep",
    "+find",
    "+ls",
    "+codemode"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "contact_supervisor",
          "codemode"
        ]
      },
      "researcher": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "codemode"
        ],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-web-access/index.ts"
        ]
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "xhigh",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "codemode"
        ],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-web-access/index.ts"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high",
        "fast": false,
        "defaultContext": "fresh",
        "tools": "inherit",
        "extensions": [],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-lens/dist/index.js",
          "{{PROFILE}}/npm/node_modules/pi-hashline-edit-pro/index.ts",
          "{{PROFILE}}/npm/node_modules/@dietrichgebert/ponytail/pi-extension/index.js"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "xhigh",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "watchdog_diff",
          "contact_supervisor",
          "codemode"
        ],
        "extensions": [],
        "excludeTools": [
          "bash",
          "powershell",
          "edit",
          "write",
          "replace",
          "insert",
          "undo_last_change"
        ],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-hashline-edit-pro/index.ts"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "codemode"
        ]
      },
      "delegate": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high",
        "fast": false,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "codemode"
        ],
        "allowNestedSubagents": true,
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/@dietrichgebert/ponytail/pi-extension/index.js"
        ]
      }
    }
  },
  "tuiMode": "fullscreen",
  "markdown": {
    "mermaid": "streaming"
  },
  "workingVibe": "cyberpunk 2077",
  "powerline": {
    "welcome": false,
    "preset": "default",
    "placement": "above"
  },
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": false
  }
}
