{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:pi-lens",
    "npm:pi-zentui",
    "npm:@narumitw/pi-usage",
    "npm:@dietrichgebert/ponytail",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-hashline-edit-pro",
    "npm:pi-subagents"
  ],
  "hideThinkingBlock": false,
  "externalEditor": "code --wait",
  "shellPath": "C:/Program Files/Git/bin/bash.exe",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "ls"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "github-copilot/claude-opus-5",
    "openai-codex/gpt-6-astra"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium",
        "fast": true,
        "defaultContext": "fresh"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium",
        "fast": true,
        "defaultContext": "fresh",
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-web-access/index.ts"
        ]
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "xhigh",
        "fast": true,
        "defaultContext": "fresh",
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-web-access/index.ts"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high",
        "fast": true,
        "defaultContext": "fresh",
        "tools": [
          "read",
          "write",
          "replace",
          "insert",
          "lsp_navigation",
          "lsp_diagnostics",
          "read_symbol",
          "symbol_search",
          "module_report",
          "anchor_grep",
          "find",
          "ls",
          "bash",
          "contact_supervisor"
        ],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-lens/dist/index.js",
          "{{PROFILE}}/npm/node_modules/pi-hashline-edit-pro/index.ts",
          "{{PROFILE}}/npm/node_modules/@gotgenes/pi-permission-system/src/index.ts"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "xhigh",
        "fast": true,
        "defaultContext": "fresh",
        "extensions": [],
        "excludeTools": [
          "bash",
          "powershell",
          "edit",
          "write",
          "replace",
          "insert",
          "undo_last_change"
        ],
        "subagentOnlyExtensions": [
          "{{PROFILE}}/npm/node_modules/pi-hashline-edit-pro/index.ts"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high",
        "fast": true,
        "defaultContext": "fresh"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high",
        "fast": true,
        "defaultContext": "fresh",
        "allowNestedSubagents": true
      }
    }
  }
}
